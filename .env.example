# API
# API_HOST=0.0.0.0 is the CONTAINER-facing bind: the host port is published on
# 127.0.0.1 only (see deploy/compose.dev.yml). Never publish 0.0.0.0 on the VM.
APP_ENV=development
APP_NAME=childhood-library
APP_VERSION=0.5.0
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_JSON=true
LOG_DIR=./var/logs
HEALTH_CHECK_DB=true
DB_TCP_HOST=127.0.0.1
DB_TCP_PORT=55432

# PostgreSQL (replace locally; never commit real credentials)
# Host venv / Alembic use this 127.0.0.1 DSN. The api container overrides it in
# compose.dev.yml with db:5432 (Compose network), built from the SAME
# POSTGRES_USER / POSTGRES_PASSWORD / CL_DEV_DB_NAME values below.
# Keep host/port/name in sync with CL_DEV_DB_PORT / CL_DEV_DB_NAME.
DATABASE_URL=postgresql+psycopg://app:change-me@127.0.0.1:55432/childhood_library_dev
HEALTH_CHECK_SQL=true

# Redis / task queue (optional in the first MVP iteration)
REDIS_URL=redis://localhost:6379/0

# Object storage (only for authorized media)
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

# AI provider configuration (optional; keep keys outside source control)
AI_PROVIDER=
AI_API_BASE=
AI_API_KEY=
AI_MODEL=

# Compose / VM skeleton (Phase 1); all internal ports bind to 127.0.0.1
# Copy this file to the REPO ROOT as .env (chmod 600). Docker Compose must be
# invoked with `--project-directory .` so it loads this .env instead of deploy/.env.
# Database names are chosen by the overlay, NOT by a global POSTGRES_DB:
#   compose.dev.yml  -> CL_DEV_DB_NAME
#   compose.test.yml -> CL_TEST_DB_NAME
CL_PROJECT=cl-dev
CL_DEV_DB_PORT=55432
CL_TEST_DB_PORT=55433
CL_API_PORT=58000
CL_DEV_DB_NAME=childhood_library_dev
CL_TEST_DB_NAME=childhood_library_test
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
MEDIA_ROOT=./var/media
TEST_MEDIA_ROOT=./var/media-test
LOG_ROOT=./var/logs
BACKUP_ROOT=./var/backups
