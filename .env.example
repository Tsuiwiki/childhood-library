# API
APP_ENV=development
APP_NAME=childhood-library
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL (replace locally; never commit real credentials)
DATABASE_URL=postgresql+psycopg://app:change-me@localhost:5432/childhood_library

# Redis / task queue (optional in the first MVP iteration)
REDIS_URL=redis://localhost:6379/0

# Object storage (only for authorized media)
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

# AI provider configuration (optional; keep keys outside source control)
AI_PROVIDER=
AI_API_BASE=
AI_API_KEY=
AI_MODEL=
