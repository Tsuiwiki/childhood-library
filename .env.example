# API
APP_ENV=development
APP_NAME=childhood-library
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL (replace locally; never commit real credentials)
# T-05+ only: keep host/port/name in sync with CL_DEV_DB_PORT / CL_DEV_DB_NAME below.
DATABASE_URL=postgresql+psycopg://app:change-me@127.0.0.1:55432/childhood_library_dev

# Redis / task queue (optional in the first MVP iteration)
REDIS_URL=redis://localhost:6379/0

# Object storage (only for authorized media)
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

# AI provider configuration (optional; keep keys outside source control)
AI_PROVIDER=
AI_API_BASE=
AI_API_KEY=
AI_MODEL=

# Compose / VM skeleton (Phase 1); all internal ports bind to 127.0.0.1
# Database names are chosen by the overlay, NOT by a global POSTGRES_DB:
#   compose.dev.yml  -> CL_DEV_DB_NAME
#   compose.test.yml -> CL_TEST_DB_NAME
CL_PROJECT=cl-dev
CL_DEV_DB_PORT=55432
CL_TEST_DB_PORT=55433
CL_API_PORT=58000
CL_DEV_DB_NAME=childhood_library_dev
CL_TEST_DB_NAME=childhood_library_test
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
MEDIA_ROOT=./var/media
TEST_MEDIA_ROOT=./var/media-test
BACKUP_ROOT=./var/backups
