# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node
node_modules/
dist/
.vite/

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Local data and media
# Root-only on purpose: `media/` would also match app/media/, which is T-07
# SOURCE CODE and must stay tracked. Runtime media lives in var/ (below).
data/
uploads/
/media/
var/
*.sqlite3
*.db
*.dump

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Public repo = docs + source only.
# Audio/video media may exist only in the internal environment and are intentionally
# excluded from GitHub. Do not delete, move, or overwrite local files during cleanup.
# Inventory actual files and verify backups/checksums before any migration.
# Rights and public playback status must be assessed per recording; ignored files
# may include internal research, open-licensed, and generated demonstration media.
design-demos/audio/*.mp3
design-demos/audio/*.m4a
design-demos/audio/*.mp4
design-demos/audio/*.flac
design-demos/audio/*.wav
design-demos/audio/*.ogg
design-demos/audio/*.oga
design-demos/audio/*.opus
design-demos/audio/*.webm
design-demos/audio/*.aac

# Reference images and Playwright validation screenshots are local artifacts.
design-demos/refs/*.png
design-demos/refs/*.jpg
design-demos/refs/*.jpeg
design-demos/refs/*.webp
design-demos/refs/*.txt
design-demos/*.png
design-demos/*.jpg
design-demos/shots-*/
design-demos/_cover_check.*
design-demos/probe-commons-run.log
